# ==============================================================================
# Rust (core/)
# ==============================================================================
# Target directory produced by Cargo builds
/target/
**/target/

# Cargo backup files
**/*.rs.bk

# LLVM coverage & profiling (tarpaulin, llvm-cov)
*.profraw
*.profdata
coverage/

# ==============================================================================
# ROS 2, C++ & colcon (adapter/ & sim/)
# ==============================================================================
# Build, install, and log folders generated by colcon build
build/
install/
log/
**/build/
**/install/
**/log/

# colcon generated files
*.log
colcon.meta

# Python artifacts (ROS 2 launch files, tests, nodes)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# ==============================================================================
# C++ & CMake Artifacts
# ==============================================================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!**/CMakeLists.txt

# Compiled Object & Binary Files
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib

# ==============================================================================
# Gazebo & Simulation (sim/)
# ==============================================================================
.gazebo/
**/gazebo_models/*/model.config.bak

